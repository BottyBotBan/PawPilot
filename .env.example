PORT=3000
HOST=127.0.0.1

# Use a unique passphrase with at least 14 characters.
DASHBOARD_PASSWORD=

# Set local to read the device directly without using the cloud API.
TUYA_MODE=local
TUYA_DEVICE_ID=
TUYA_LOCAL_IP=
TUYA_LOCAL_VERSION=3.5
# Absolute path to the TinyTuya wizard's private devices.json file.
TUYA_LOCAL_DEVICE_FILE=
# Path to the Python executable where requirements.txt is installed.
TUYA_LOCAL_PYTHON=python3

# Used only when TUYA_MODE=cloud.
# Smart Life app account region must match this Tuya data center.
TUYA_ENDPOINT=https://openapi.tuyaeu.com
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# Leave empty until the YJE030 function list confirms the manual-clean command.
TUYA_CLEAN_COMMAND_CODE=
# JSON value expected by the confirmed command, for example true or 1.
TUYA_CLEAN_COMMAND_VALUE=true
